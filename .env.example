# ===== API base URL =====
# Resolution order used by the app: NEXT_PUBLIC_BASE_API_URL || NEXT_PUBLIC_LOCAL_API_URL

# Remote / production API
NEXT_PUBLIC_BASE_API_URL=https://taskback.orbit-eng.net/api

# Local backend (fallback when the base URL above is empty)
NEXT_PUBLIC_LOCAL_API_URL=http://localhost:8000/api

# ===== Optional: same-origin API proxy =====
# Useful when the browser cannot call the API directly (missing CORS preflight,
# expired/self-signed TLS certificate, mixed content, firewalls...).
# When true, the browser calls /api/... on this Next app and Next proxies to
# API_SERVER_URL server-side. Default (unset/false): the browser calls the API directly.
# NEXT_PUBLIC_API_PROXY=true
# API_SERVER_URL=https://taskback.orbit-eng.net/api
# Dev-only escape hatch for a broken certificate. NEVER enable in production.
# API_PROXY_INSECURE_TLS=true

# ===== Optional: HTTP method override (IIS/Plesk workaround) =====
# The backend web server (IIS + Plesk/WebDAV) answers 405 to PUT/PATCH/DELETE
# before the request ever reaches Laravel. When this is not "false" the app
# sends those verbs as POST + X-HTTP-Method-Override, which Laravel/Symfony
# honours natively, so the result is identical on a healthy server.
# Set to false only if you want to send the real verbs again.
# NEXT_PUBLIC_HTTP_METHOD_OVERRIDE=false

# For production JWT secret
JWT_SECRET=your-secret-key-here